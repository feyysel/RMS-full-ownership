generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id @default(cuid())
  name                String
  phone               String             @unique
  passwordHash        String
  role                Role
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  restaurantId        String?
  notifications       Notification[]
  orders              Order[]            @relation("OrderWaiter")
  cashierOrders       Order[]            @relation("OrderCashier")
  receipts            Receipt[]          @relation("ReceiptKitchen")
  tables              Table[]            @relation("TableWaiter")
  pushSubscriptions   PushSubscription[]
  restaurant          Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, role])
}

model Restaurant {
  id            String           @id @default(cuid())
  name          String
  address       String?
  phone         String?
  theme         String?
  logoUrl       String?
  parentId      String?
  parent        Restaurant?      @relation("RestaurantBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches      Restaurant[]     @relation("RestaurantBranches")
  createdAt     DateTime         @default(now())
  categories    Category[]
  menuItems     MenuItem[]
  notifications Notification[]
  orders        Order[]
  receipts      Receipt[]
  tables        Table[]
  users         User[]
}

model Table {
  id           String     @id @default(cuid())
  number       Int
  code         String     @unique
  status       String     @default("free")
  restaurantId String
  waiterId     String?
  bellCalls    BellCall[]
  orders       Order[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  waiter       User?      @relation("TableWaiter", fields: [waiterId], references: [id])

  @@unique([restaurantId, number])
  @@index([waiterId])
  @@index([restaurantId, status])
  @@index([restaurantId, waiterId])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String      @id @default(cuid())
  name         String
  description  String?
  ingredients  String
  price        Float
  imageUrl     String?
  available    Boolean     @default(true)
  isPopular    Boolean     @default(false)
  categoryId   String?
  restaurantId String
  createdAt    DateTime    @default(now())
  category     Category?   @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, available])
  @@index([restaurantId, createdAt])
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      Int
  type             OrderType      @default(DINE_IN)
  status           OrderStatus    @default(PENDING)
  note             String?
  total            Float          @default(0)
  discount         Float          @default(0)
  discountReason   String?
  paymentMethod    PaymentMethod?
  paidAt           DateTime?
  collectedAmount  Float?
  tip              Float?
  voided           Boolean        @default(false)
  voidReason       String?
  voidedAt         DateTime?
  voidedBy         String?
  refunded         Boolean        @default(false)
  refundReason     String?
  refundedAt       DateTime?
  refundedBy       String?
  tableId          String?
  tableLabel       String?
  sourceTableCode  String?
  waiterId         String?
  cashierId        String?
  restaurantId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table            Table?         @relation(fields: [tableId], references: [id])
  waiter           User?          @relation("OrderWaiter", fields: [waiterId], references: [id])
  cashier          User?          @relation("OrderCashier", fields: [cashierId], references: [id])
  items            OrderItem[]
  receipt          Receipt?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@index([waiterId, status, createdAt])
  @@index([cashierId, status, createdAt])
  @@index([tableId, status])
  @@index([restaurantId, waiterId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  price      Float
  quantity   Int
  status     OrderItemStatus @default(PENDING)
  menuItem   MenuItem?       @relation(fields: [menuItemId], references: [id])
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@index([name])
}

model Receipt {
  id            String         @id @default(cuid())
  orderId       String         @unique
  items         String
  subtotal      Float
  discount      Float          @default(0)
  tax           Float
  total         Float
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  kitchenId     String?
  restaurantId  String
  generatedAt   DateTime       @default(now())
  kitchen       User?          @relation("ReceiptKitchen", fields: [kitchenId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, generatedAt])
}

model BellCall {
  id          String     @id @default(cuid())
  tableId     String
  status      BellStatus @default(RINGING)
  createdAt   DateTime   @default(now())
  resolvedAt  DateTime?
  respondedBy String?
  table       Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, status])
  @@index([tableId, status, createdAt])
}

model Notification {
  id           String       @id @default(cuid())
  userId       String?
  role         Role?
  restaurantId String?
  type         String
  title        String
  body         String
  read         Boolean      @default(false)
  orderId      String?
  tableId      String?
  createdAt    DateTime     @default(now())
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([restaurantId, role, read])
}

model EventLog {
  id        String   @id @default(cuid())
  scope     String
  scopeId   String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([scope, scopeId, createdAt])
  @@index([createdAt])
  @@index([scope, createdAt])
}

enum Role {
  OWNER
  MANAGER
  KITCHEN
  WAITER
  CASHIER
}

enum OrderStatus {
  PENDING
  TAKEN
  PAID
  ACCEPTED
  COOKING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  ACCEPTED
  COOKING
  READY
  SERVED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  CARD
  CARD_ONLINE
  OTHER
}

enum BellStatus {
  RINGING
  RESPONDED
  DISMISSED
}

model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String
  p256dh        String
  auth          String
  userId        String
  restaurantId  String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([restaurantId])
  @@index([endpoint])
}
